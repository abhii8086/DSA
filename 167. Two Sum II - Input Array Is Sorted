TC:O(n^2)
SC:O(1)
//-------------------------------------------------------

        int n = numbers.length;
        int sum =0;

//since array is sorted and need pairs (two pointers) 

        int start=0;
        int end = n-1;

         while(start<end){
            sum = numbers[start]+numbers[end];
                if(sum==target) return new int[] {start+1,end+1};
                    
                    if(sum<target){
                        start++;
                    }else{
                        end--;
                    }
         }
         return new int[] {-1,-1};
    }
}

TC:O(n)
SC:O(1)
